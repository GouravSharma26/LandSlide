{
  "benchmark_tier": "controlled_scientific_comparison",
  "model_designation": "Model A \u2014 Single-Modality SAR Baseline",
  "model_type": "UNet",
  "experiment_id": "benchmark_model_a_sar_unet",
  "version": "1.0.0",
  "task": "binary_landslide_segmentation",
  "modalities_used": [
    "Sentinel-1 SAR (VV, VH)"
  ],
  "temporal_slice": -1,
  "model_config": "configs/models/unet_s1_baseline.json",
  "split_manifest": "data/manifests/sen12landslides_disjoint_manifest.csv",
  "split_manifest_fallback": "data/manifests/synthetic_split_manifest.csv",
  "training": {
    "batch_size": 2,
    "epochs": 1,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "scheduler": "CosineAnnealingLR",
    "patience": 10,
    "monitor_metric": "val_iou",
    "monitor_mode": "max"
  },
  "loss": {
    "name": "CombinedBCEDiceLoss",
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "smooth": 1e-06
  },
  "seed": 42,
  "device_preference": "cpu",
  "output_directory": "artifacts/geotrustnet/experiments/benchmark_model_a"
}