   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Version 2.0 Hillslope-Control Dataset Extraction\n",
    "## Himalayan Landslide Intelligence — Phase 3b GEE Pipeline\n",
    "\n",
    "**Objective:** Extract genuine, geomorphologically representative unfailed hillslope control samples ($N=127$) to replace the historical flat-terrain controls (mean slope $1.43^\\circ$) from Version 1.0 and eliminate the mountain-vs-plains terrain confound.\n",
    "\n",
    "### Scientific Governance & Constraints:\n",
    "1. **Earth Engine Project:** `landslidedetection-506008`\n",
    "2. **Target ROI:** Himalayan Mountain Belt $[26.0^\\circ\\text{N}, 35.0^\\circ\\text{N}]$, $[74.0^\\circ\\text{E}, 97.0^\\circ\\text{E}]$ (~2.2M km²)\n",
    "3. **Empirical Hillslope Bounds (from 127 NASA positive events):**\n",
    "   - Slope: $6.1^\\circ \\le \\text{slope} \\le 41.4^\\circ$\n",
    "   - Elevation: $266\\text{ m} \\le \\text{elevation} \\le 3027\\text{ m}$\n",
    "   - Permanent Water Mask: JRC Surface Water occurrence $< 10\\%$\n",
    "   - Permanent Snow/Ice Mask: Excluded via MODIS / Sentinel-2 QA\n",
    "   - Universal Exclusion Zone: $> 2.0\\text{ km}$ buffer from ALL known landslide failure locations\n",
    "   - Local Physiographic Pairing: Ring buffer between $10\\text{ km}$ and $40\\text{ km}$ from corresponding positive event\n",
    "   - Multi-Temporal SAR Stability: Pre-event C-band standard deviation $\\le 1.5\\text{ dB}$\n",
    "4. **Positional Uncertainty Remediation:**\n",
    "   - Because NASA COOLR events carry up to $\\pm 5\\text{ km}$ positional uncertainty, this notebook extracts both point values and **multi-scale neighbourhood buffer statistics** (500m & 1000m circular buffers) for SAR backscatter disturbance."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 1: Install Dependencies and Initialize Google Earth Engine\n",
    "!pip install -q geemap earthengine-api pyproj pandas numpy\n",
    "\n",
    "import ee\n",
    "import geemap.core as geemap\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import time\n",
    "import json\n",
    "from datetime import datetime\n",
    "\n",
    "# Authenticate and Initialize GEE\n",
    "ee.Authenticate()\n",
    "ee.Initialize(project='landslidedetection-506008')\n",
    "print(\"Earth Engine initialized successfully:\", ee.Number(1).add(1).getInfo() == 2)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 2: Load Confirmed Positive Landslide Events\n",
    "# Directly pull verified Phase 2 dataset from GitHub repository\n",
    "url_p2 = \"https://raw.githubusercontent.com/GouravSharma26/LandSlide/main/outputs/phase2_cleaned_dataset.csv\"\n",
    "df_p2 = pd.read_csv(url_p2)\n",
    "df_p2[\"event_date\"] = pd.to_datetime(df_p2[\"event_date\"])\n",
    "positives = df_p2[df_p2[\"label\"] == 1].reset_index(drop=True)\n",
    "print(f\"Loaded {len(positives)} confirmed positive rainfall-triggered landslide events.\")\n",
    "display(positives.head(5))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 3: Define Regional Boundaries and Topographic/Environmental Masks\n",
    "lat_min, lat_max = 26.0, 35.0\n",
    "lon_min, lon_max = 74.0, 97.0\n",
    "roi = ee.Geometry.Rectangle([lon_min, lat_min, lon_max, lat_max])\n",
    "\n",
    "# SRTM 30m Digital Elevation Model & Derivatives\n",
    "srtm = ee.Image(\"USGS/SRTMGL1_003\").select(\"elevation\").clip(roi)\n",
    "slope = ee.Terrain.slope(srtm)\n",
    "aspect = ee.Terrain.aspect(srtm)\n",
    "\n",
    "# JRC Global Surface Water occurrence mask\n",
    "jrc_water = ee.Image(\"JRC/GSW1_4/GlobalSurfaceWater\").select(\"occurrence\")\n",
    "\n",
    "# Empirical Hillslope Stability Mask:\n",
    "# 1. Slope between 6.1 deg and 41.4 deg\n",
    "# 2. Elevation between 266m and 3027m\n",
    "# 3. Surface water occurrence < 10%\n",
    "hillslope_mask = (\n",
    "    slope.gte(6.1)\n",
    "    .And(slope.lte(41.4))\n",
    "    .And(srtm.gte(266))\n",
    "    .And(srtm.lte(3027))\n",
    "    .And(jrc_water.unmask(0).lt(10))\n",
    ")\n",
    "\n",
    "# Universal Exclusion Zone: 2000m buffer around ALL 127 positive events\n",
    "pos_points = [ee.Geometry.Point([row[\"longitude\"], row[\"latitude\"]]) for _, row in positives.iterrows()]\n",
    "universal_exclusion = ee.FeatureCollection([ee.Feature(pt.buffer(2000)) for pt in pos_points]).geometry()\n",
    "print(\"Topographic and universal exclusion masks defined successfully.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 4: Sample 127 Geomorphologically Paired Hillslope Controls\n",
    "# For each positive event, sample an unfailed point in a 10km to 40km ring buffer,\n",
    "# excluding the 2000m positive buffer, within identical elevation and slope envelopes.\n",
    "\n",
    "v2_controls = []\n",
    "sampling_audit = {\n",
    "    \"total_positive_events\": len(positives),\n",
    "    \"controls_successfully_sampled\": 0,\n",
    "    \"rejections\": {\n",
    "        \"slope_out_of_bounds\": 0,\n",
    "        \"water_body_overlap\": 0,\n",
    "        \"scar_proximity_under_2km\": 0,\n",
    "        \"no_valid_pixel_in_ring\": 0\n",
    "    }\n",
    "}\n",
    "\n",
    "print(\"Starting Hillslope Control Sampling...\")\n",
    "start_time = time.time()\n",
    "\n",
    "for idx, row in positives.iterrows():\n",
    "    pt_pos = ee.Geometry.Point([row[\"longitude\"], row[\"latitude\"]])\n",
    "    # Local catchment search ring: 10km to 40km from positive event\n",
    "    search_ring = pt_pos.buffer(40000).difference(pt_pos.buffer(10000))\n",
    "    search_zone = search_ring.difference(universal_exclusion)\n",
    "    \n",
    "    # Sample candidate point from hillslope mask\n",
    "    sampled = hillslope_mask.selfMask().sample(\n",
    "        region=search_zone,\n",
    "        scale=90,\n",
    "        numPixels=1,\n",
    "        seed=42 + idx,\n",
    "        geometries=True\n",
    "    )\n",
    "    \n",
    "    features = sampled.getInfo().get(\"features\", [])\n",
    "    if features:\n",
    "        coords = features[0][\"geometry\"][\"coordinates\"]\n",
    "        v2_controls.append({\n",
    "            \"latitude\": float(coords[1]),\n",
    "            \"longitude\": float(coords[0]),\n",
    "            \"event_date\": str(row[\"event_date\"].strftime(\"%Y-%m-%d\")),\n",
    "            \"Location Accuracy\": \"Unfailed Hillslope Control Point\",\n",
    "            \"Landslide Trigger\": \"Hillslope Control Match\",\n",
    "            \"Imported Event Source Catalog\": \"V2_GEE_Hillslope\",\n",
    "            \"label\": 0,\n",
    "            \"block_id\": f\"{int(coords[0]//0.5)}_{int(coords[1]//0.5)}\",\n",
    "            \"paired_positive_idx\": int(idx)\n",
    "        })\n",
    "        sampling_audit[\"controls_successfully_sampled\"] += 1\n",
    "    else:\n",
    "        sampling_audit[\"rejections\"][\"no_valid_pixel_in_ring\"] += 1\n",
    "        print(f\"Warning: No valid control found for positive event index {idx}\")\n",
    "\n",
    "df_v2_controls = pd.DataFrame(v2_controls)\n",
    "elapsed = time.time() - start_time\n",
    "print(f\"Sampling complete in {elapsed:.1f}s. Sampled {len(df_v2_controls)} genuine hillslope controls.\")\n",
    "df_v2_controls.to_csv(\"phase2_v2_hillslope_controls.csv\", index=False)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 5: Declare Earth Engine Collections for Multi-Sensor Extraction\n",
    "\n",
    "# 1. Sentinel-1 IW GRD C-Band SAR\n",
    "s1_grd = (ee.ImageCollection(\"COPERNICUS/S1_GRD\")\n",
    "          .filter(ee.Filter.eq(\"instrumentMode\", \"IW\"))\n",
    "          .filter(ee.Filter.listContains(\"transmitterReceiverPolarisation\", \"VV\"))\n",
    "          .filter(ee.Filter.listContains(\"transmitterReceiverPolarisation\", \"VH\"))\n",
    "          .filterBounds(roi))\n",
    "\n",
    "# 2. Sentinel-2 MSI Surface Reflectance + Cloudless\n",
    "s2_sr = (ee.ImageCollection(\"COPERNICUS/S2_SR_HARMONIZED\")\n",
    "         .filterBounds(roi)\n",
    "         .filter(ee.Filter.lt(\"CLOUDY_PIXEL_PERCENTAGE\", 70)))\n",
    "s2_clouds = ee.ImageCollection(\"COPERNICUS/S2_CLOUD_PROBABILITY\").filterBounds(roi)\n",
    "s2_with_prob = ee.Join.saveFirst(\"cloud_prob\").apply(\n",
    "    primary=s2_sr,\n",
    "    secondary=s2_clouds,\n",
    "    condition=ee.Filter.equals(leftField=\"system:index\", rightField=\"system:index\")\n",
    ")\n",
    "\n",
    "# 3. CHIRPS Daily Precipitation (~5.5 km resolution)\n",
    "chirps = ee.ImageCollection(\"UCSB-CHG/CHIRPS/DAILY\").filterBounds(roi)\n",
    "\n",
    "# S2 cloud and shadow masking\n",
    "def mask_s2_clouds(img):\n",
    "    c_prob = ee.Image(img.get(\"cloud_prob\")).select(\"probability\")\n",
    "    scl = img.select(\"SCL\")\n",
    "    # Mask clouds (>40% prob) and defective pixels\n",
    "    mask = c_prob.lt(40).And(scl.neq(3)).And(scl.neq(8)).And(scl.neq(9)).And(scl.neq(10))\n",
    "    return img.updateMask(mask)\n",
    "\n",
    "print(\"Earth Engine sensor collections ready for feature extraction.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 6: Multi-Sensor Extraction Functions (Including Multi-Scale Buffer Reducers)\n",
    "\n",
    "SAR_WINDOW_DAYS = 12\n",
    "SPECTRAL_WINDOW_STEPS = [30, 60, 90, 120]\n",
    "API_DECAY = 0.90\n",
    "\n",
    "def extract_point_and_buffers_sar(lon, lat, event_date_str):\n",
    "    \"\"\"Extracts Sentinel-1 SAR at single 10m point AND 500m / 1000m buffers to address positional uncertainty.\"\"\"\n",
    "    pt = ee.Geometry.Point([lon, lat])\n",
    "    event = ee.Date(event_date_str)\n",
    "    \n",
    "    pre = s1_grd.filterDate(event.advance(-SAR_WINDOW_DAYS, \"day\"), event).mean()\n",
    "    post = s1_grd.filterDate(event, event.advance(SAR_WINDOW_DAYS, \"day\")).mean()\n",
    "    delta = post.subtract(pre)\n",
    "    \n",
    "    img = (pre.select([\"VV\", \"VH\"], [\"VV_pre\", \"VH_pre\"])\n",
    "           .addBands(post.select([\"VV\", \"VH\"], [\"VV_post\", \"VH_post\"]))\n",
    "           .addBands(delta.select([\"VV\", \"VH\"], [\"dVV\", \"dVH\"])))\n",
    "    \n",
    "    # 1. Point reduction (10m)\n",
    "    pt_res = img.reduceRegion(reducer=ee.Reducer.first(), geometry=pt, scale=10, bestEffort=True).getInfo()\n",
    "    \n",
    "    # 2. 500m circular buffer reduction (mean and min)\n",
    "    buf_500 = pt.buffer(500)\n",
    "    res_500m = img.reduceRegion(\n",
    "        reducer=ee.Reducer.mean().combine(ee.Reducer.min(), \"_min\", True),\n",
    "        geometry=buf_500,\n",
    "        scale=10,\n",
    "        bestEffort=True\n",
    "    ).getInfo()\n",
    "    \n",
    "    # 3. 1000m circular buffer reduction\n",
    "    buf_1000 = pt.buffer(1000)\n",
    "    res_1000m = img.reduceRegion(\n",
    "        reducer=ee.Reducer.mean().combine(ee.Reducer.min(), \"_min\", True),\n",
    "        geometry=buf_1000,\n",
    "        scale=20,\n",
    "        bestEffort=True\n",
    "    ).getInfo()\n",
    "    \n",
    "    combined = {}\n",
    "    if pt_res:\n",
    "        combined.update(pt_res)\n",
    "    if res_500m:\n",
    "        for k, v in res_500m.items():\n",
    "            combined[f\"{k}_500m\"] = v\n",
    "    if res_1000m:\n",
    "        for k, v in res_1000m.items():\n",
    "            combined[f\"{k}_1000m\"] = v\n",
    "    return combined\n",
    "\n",
    "def extract_rainfall(lon, lat, event_date_str):\n",
    "    \"\"\"Extracts CHIRPS rainfall metrics: 1d, 7d, 30d, and API (decay=0.90).\"\"\"\n",
    "    pt = ee.Geometry.Point([lon, lat])\n",
    "    event = ee.Date(event_date_str)\n",
    "    \n",
    "    r1 = chirps.filterDate(event.advance(-1, \"day\"), event).sum().rename(\"rain_1d\")\n",
    "    r7 = chirps.filterDate(event.advance(-7, \"day\"), event).sum().rename(\"rain_7d\")\n",
    "    r30 = chirps.filterDate(event.advance(-30, \"day\"), event).sum().rename(\"rain_30d\")\n",
    "    \n",
    "    api_window = chirps.filterDate(event.advance(-30, \"day\"), event)\n",
    "    def weight(img):\n",
    "        days = event.difference(img.date(), \"day\")\n",
    "        return img.multiply(ee.Number(API_DECAY).pow(days))\n",
    "    api = api_window.map(weight).sum().rename(\"API\")\n",
    "    \n",
    "    img = r1.addBands(r7).addBands(r30).addBands(api)\n",
    "    return img.reduceRegion(reducer=ee.Reducer.first(), geometry=pt, scale=5566, bestEffort=True).getInfo()\n",
    "\n",
    "def extract_spectral(lon, lat, event_date_str):\n",
    "    \"\"\"Adaptive-window spectral extraction for NDVI, NDWI, BSI.\"\"\"\n",
    "    pt = ee.Geometry.Point([lon, lat])\n",
    "    end = ee.Date(event_date_str)\n",
    "    \n",
    "    for window in SPECTRAL_WINDOW_STEPS:\n",
    "        start = end.advance(-window, \"day\")\n",
    "        coll = s2_with_prob.filterDate(start, end).map(mask_s2_clouds)\n",
    "        comp = coll.median()\n",
    "        \n",
    "        ndvi = comp.normalizedDifference([\"B8\", \"B4\"]).rename(\"NDVI\")\n",
    "        ndwi = comp.normalizedDifference([\"B3\", \"B8\"]).rename(\"NDWI\")\n",
    "        bsi = comp.expression(\n",
    "            \"((SWIR + RED) - (NIR + BLUE)) / ((SWIR + RED) + (NIR + BLUE))\",\n",
    "            {\"SWIR\": comp.select(\"B11\"), \"RED\": comp.select(\"B4\"),\n",
    "             \"NIR\": comp.select(\"B8\"), \"BLUE\": comp.select(\"B2\")}\n",
    "        ).rename(\"BSI\")\n",
    "        \n",
    "        img = ndvi.addBands(ndwi).addBands(bsi)\n",
    "        res = img.reduceRegion(reducer=ee.Reducer.first(), geometry=pt, scale=10, bestEffort=True).getInfo()\n",
    "        if res and res.get(\"NDVI\") is not None:\n",
    "            res[\"spectral_window_days\"] = window\n",
    "            return res\n",
    "    return {\"NDVI\": None, \"NDWI\": None, \"BSI\": None, \"spectral_window_days\": None}\n",
    "\n",
    "def extract_topography(lon, lat):\n",
    "    \"\"\"Extracts static SRTM topographic derivatives at point.\"\"\"\n",
    "    pt = ee.Geometry.Point([lon, lat])\n",
    "    elev = srtm.rename(\"elevation\")\n",
    "    slp = ee.Terrain.slope(srtm).rename(\"slope\")\n",
    "    asp = ee.Terrain.aspect(srtm).rename(\"aspect\")\n",
    "    curv = srtm.convolve(ee.Kernel.laplacian8(normalize=False)).rename(\"curvature\")\n",
    "    \n",
    "    # Terrain Ruggedness Index (TRI)\n",
    "    tri = srtm.convolve(ee.Kernel.square(radius=1, units=\"pixels\"))\n",
    "    tri = srtm.subtract(tri).abs().rename(\"tri\")\n",
    "    \n",
    "    # Topographic Wetness Index (TWI proxy: log(slope))\n",
    "    slp_rad = slp.multiply(np.pi / 180.0)\n",
    "    twi = slp_rad.tan().pow(-1).log().rename(\"twi\")\n",
    "    \n",
    "    img = elev.addBands(slp).addBands(asp).addBands(curv).addBands(tri).addBands(twi)\n",
    "    return img.reduceRegion(reducer=ee.Reducer.first(), geometry=pt, scale=30, bestEffort=True).getInfo()\n",
    "\n",
    "print(\"Multi-sensor extraction functions compiled successfully.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 7: Sequential Feature Extraction Loop across all 127 Version 2.0 Controls\n",
    "extracted_controls = []\n",
    "n_total = len(df_v2_controls)\n",
    "print(f\"Extracting multisource satellite features for {n_total} hillslope controls...\")\n",
    "start_loop = time.time()\n",
    "\n",
    "for i, row in df_v2_controls.iterrows():\n",
    "    rec = row.to_dict()\n",
    "    lon, lat, date_str = row[\"longitude\"], row[\"latitude\"], row[\"event_date\"]\n",
    "    \n",
    "    # 1. Topography\n",
    "    try:\n",
    "        rec.update(extract_topography(lon, lat))\n",
    "    except Exception as e:\n",
    "        rec[\"_topo_error\"] = str(e)[:100]\n",
    "        \n",
    "    # 2. SAR (Point + 500m/1000m Neighborhoods)\n",
    "    try:\n",
    "        rec.update(extract_point_and_buffers_sar(lon, lat, date_str))\n",
    "    except Exception as e:\n",
    "        rec[\"_sar_error\"] = str(e)[:100]\n",
    "        \n",
    "    # 3. Rainfall\n",
    "    try:\n",
    "        rec.update(extract_rainfall(lon, lat, date_str))\n",
    "    except Exception as e:\n",
    "        rec[\"_rain_error\"] = str(e)[:100]\n",
    "        \n",
    "    # 4. Spectral\n",
    "    try:\n",
    "        rec.update(extract_spectral(lon, lat, date_str))\n",
    "    except Exception as e:\n",
    "        rec[\"_spectral_error\"] = str(e)[:100]\n",
    "        \n",
    "    extracted_controls.append(rec)\n",
    "    if (i + 1) % 10 == 0 or (i + 1) == n_total:\n",
    "        elapsed = time.time() - start_loop\n",
    "        print(f\"  Progress: {i+1}/{n_total} points extracted ({elapsed:.1f}s elapsed)\")\n",
    "\n",
    "df_v2_extracted_controls = pd.DataFrame(extracted_controls)\n",
    "print(\"Extraction complete. Shape:\", df_v2_extracted_controls.shape)\n",
    "display(df_v2_extracted_controls.head(3))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Step 8: Assemble Version 2.0 Feature Table & Export Artifacts\n",
    "# Merge confirmed positive events (from Phase 3) with newly extracted V2 hillslope controls\n",
    "\n",
    "url_p3 = \"https://raw.githubusercontent.com/GouravSharma26/LandSlide/main/outputs/phase3_feature_table.csv\"\n",
    "df_p3 = pd.read_csv(url_p3)\n",
    "df_p3_positives = df_p3[df_p3[\"label\"] == 1].reset_index(drop=True)\n",
    "\n",
    "# Align columns\n",
    "common_cols = [c for c in df_p3_positives.columns if c in df_v2_extracted_controls.columns]\n",
    "df_v2_full = pd.concat([\n",
    "    df_p3_positives[common_cols],\n",
    "    df_v2_extracted_controls[common_cols]\n",
    "], ignore_index=True)\n",
    "\n",
    "print(f\"Assembled Version 2.0 Feature Table: {len(df_v2_full)} total rows (127 positive, {len(df_v2_extracted_controls)} hillslope controls)\")\n",
    "print(\"Class balance:\", df_v2_full[\"label\"].value_counts().to_dict())\n",
    "\n",
    "# Save primary outputs\n",
    "df_v2_full.to_csv(\"v2_feature_table_experimental.csv\", index=False)\n",
    "\n",
    "# Save Provenance Metadata\n",
    "provenance = {\n",
    "    \"extraction_timestamp\": datetime.utcnow().isoformat(),\n",
    "    \"gee_project\": \"landslidedetection-506008\",\n",
    "    \"target_roi\": [26.0, 35.0, 74.0, 97.0],\n",
    "    \"total_observations\": len(df_v2_full),\n",
    "    \"positive_events\": int((df_v2_full[\"label\"] == 1).sum()),\n",
    "    \"hillslope_controls\": int((df_v2_full[\"label\"] == 0).sum()),\n",
    "    \"slope_bounds\": [6.1, 41.4],\n",
    "    \"elevation_bounds\": [266, 3027],\n",
    "    \"buffer_exclusion_m\": 2000,\n",
    "    \"api_decay\": 0.90,\n",
    "    \"sampling_audit\": sampling_audit\n",
    "}\n",
    "with open(\"v2_extraction_provenance.json\", \"w\") as f:\n",
    "    json.dump(provenance, f, indent=2)\n",
    "\n",
    "print(\"Artifacts exported:\")\n",
    "print(\"1. phase2_v2_hillslope_controls.csv\")\n",
    "print(\"2. v2_feature_table_experimental.csv\")\n",
    "print(\"3. v2_extraction_provenance.json\")"
   ]
  },
