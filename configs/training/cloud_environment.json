{
  "target_platforms": ["Google Colab", "Kaggle", "Local Linux / Windows Workstation"],
  "python_version_min": "3.10.0",
  "python_version_recommended": "3.11.x",
  "python_version_max": "3.12.x",
  "pytorch_min": "2.2.0",
  "cuda_min": "11.8",
  "cuda_recommended": "12.1",
  "recommended_gpus": [
    {
      "model": "NVIDIA A100-SXM4-40GB / 80GB",
      "platform": "Google Colab Pro",
      "recommended_batch_size": 16,
      "mixed_precision": true,
      "num_workers": 4
    },
    {
      "model": "NVIDIA Tesla T4 (16GB)",
      "platform": "Google Colab Free / Kaggle",
      "recommended_batch_size": 8,
      "mixed_precision": true,
      "num_workers": 2
    },
    {
      "model": "NVIDIA Tesla P100 (16GB)",
      "platform": "Kaggle",
      "recommended_batch_size": 8,
      "mixed_precision": true,
      "num_workers": 2
    },
    {
      "model": "CPU Fallback",
      "platform": "Local Workstation / Smoke Test",
      "recommended_batch_size": 2,
      "mixed_precision": false,
      "num_workers": 0
    }
  ],
  "dependencies": {
    "core": [
      "torch>=2.2.0",
      "torchvision>=0.17.0",
      "numpy>=1.24.0,<2.0.0",
      "pandas>=2.0.0",
      "scipy>=1.10.0",
      "scikit-learn>=1.3.0"
    ],
    "geospatial": [
      "rasterio>=1.3.0",
      "shapely>=2.0.0"
    ],
    "visualization": [
      "matplotlib>=3.7.0",
      "plotly>=5.15.0",
      "streamlit>=1.28.0"
    ],
    "utilities": [
      "tqdm>=4.65.0",
      "huggingface-hub>=0.20.0"
    ]
  },
  "training_settings": {
    "deterministic_seed": 42,
    "cudnn_benchmark": false,
    "cudnn_deterministic": true,
    "gradient_clip_norm": 1.0,
    "mixed_precision_dtype": "float16"
  }
}
