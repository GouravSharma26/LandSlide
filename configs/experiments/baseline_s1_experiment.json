{
  "experiment_id": "geotrustnet_s1_unet_baseline",
  "version": "1.0.0",
  "task": "binary_landslide_segmentation",
  "modality": "sar",
  "temporal_slice": -1,
  "model_config": "configs/models/unet_s1_baseline.json",
  "split_manifest": "data/manifests/synthetic_split_manifest.csv",
  "training": {
    "batch_size": 4,
    "epochs": 10,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "scheduler": "CosineAnnealingLR",
    "patience": 5,
    "monitor_metric": "val_iou",
    "monitor_mode": "max"
  },
  "loss": {
    "name": "CombinedBCEDiceLoss",
    "bce_weight": 0.5,
    "dice_weight": 0.5,
    "smooth": 1e-6
  },
  "seed": 42,
  "device_preference": "cuda",
  "output_directory": "artifacts/geotrustnet/experiments/baseline_s1"
}
